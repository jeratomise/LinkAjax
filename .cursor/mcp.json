{
  "mcpServers": {
    "google-flights": {
      "url": "${env:GF_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${env:GF_MCP_AUTH_TOKEN}"
      }
    },
    "google-flights-local": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp/google-flights/dist/index.js"]
    }
  }
}
