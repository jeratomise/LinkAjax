# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://rsgexlhkihdothacjhrh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only copies of the same values (runtime-injected; avoids Vercel
# baking stale NEXT_PUBLIC_* into cached webpack chunks)
SUPABASE_URL=https://rsgexlhkihdothacjhrh.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role (server only - do not expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Encryption key for LinkedIn tokens (32 bytes, server only)
# Generate with: openssl rand -base64 32
SUPABASE_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Resend (required for magic link emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# From address must use a verified domain in Resend
# Default for testing: onboarding@resend.dev (only sends to your own email)
# Production: use your verified domain, e.g. AJAX <noreply@yourdomain.com>
RESEND_FROM=AJAX <onboarding@resend.dev>

# LinkedIn OAuth (optional - scaffold works without these)
LINKEDIN_CLIENT_ID=your_linkedin_app_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_app_client_secret
LINKEDIN_REDIRECT_URI=https://linkajax.vercel.app/api/auth/linkedin/callback

# Site URL for redirects (required in production emails)
NEXT_PUBLIC_SITE_URL=https://linkajax.vercel.app

# Flag to show LinkedIn is configured (set to "1" when credentials exist)
NEXT_PUBLIC_LINKEDIN_CONFIGURED=

# Legacy (deprecated - remove after migration)
# AJAX_PASSWORD=
# AJAX_SESSION_SECRET=
